-    void send_peer_sync(const Session& session, std::uint32_t phase, std::uint8_t status,
-                        const std::array<std::uint8_t, 32>& digest) {
-        wire::PeerSync sync;
-        sync.phase = phase;
-        sync.status = status;
-        sync.digest = digest;
-        peer_->send(wire::make_frame(wire::MsgType::kPeerSync, session.id, sync), kControlTimeout);
